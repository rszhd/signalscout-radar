# The box's .env for Radar (/root/signalscout-radar/.env). Never committed.

# Local only; compose sets it on the box.
# DATABASE_URL=postgres://radar:radar@127.0.0.1:5439/radar

# Generate once: openssl rand -hex 24
POSTGRES_PASSWORD=

# The Traefik network the SignalScout stacks join.
EDGE_NETWORK=qassist-edge

# Where "remove a post" links to: a mailto: or a URL.
RADAR_CONTACT=

# Providers: the cloud's instance keys.
SOCIALDATA_API_KEY=
SCRAPECREATORS_API_KEY=

# The model that sorts posts: a cheap one that follows a schema.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_TIMEOUT_MS=30000
# Required for the daily cap: a model with no price counts at its worst case.
AI_INPUT_PRICE_MICROS=
AI_OUTPUT_PRICE_MICROS=

# Providers and model together, per UTC day.
RADAR_DAILY_CAP_USD=2

# Sorting on the owner's Claude subscription, through the claude-bridge
# service (src/bridge, US-455): the token from `claude setup-token`, and
#   AI_PROVIDER=ollama, AI_BASE_URL=http://claude-bridge:8787/v1,
#   AI_MODEL=claude-sonnet-5-5, AI_API_KEY empty, AI_TIMEOUT_MS=60000,
#   AI_INPUT_PRICE_MICROS and AI_OUTPUT_PRICE_MICROS empty.
# The worker then counts every sort at zero, and the cap counts the searches.
CLAUDE_CODE_OAUTH_TOKEN=
BRIDGE_CONCURRENCY=5
# When Claude fails or hits its limit, the model in BRIDGE_FALLBACK_FOR goes to
# DeepSeek instead: the AI_API_KEY and the two prices above, from before.
# Prices per million tokens in micro-dollars. This spend is outside
# RADAR_DAILY_CAP_USD; the bridge stops falling back past its own daily
# budget. Claude is skipped for 15 minutes after a usage limit.
BRIDGE_FALLBACK_API_KEY=
BRIDGE_FALLBACK_MODEL=deepseek-flash
BRIDGE_FALLBACK_FOR=claude-sonnet-5-5
BRIDGE_FALLBACK_INPUT_PRICE_MICROS=
BRIDGE_FALLBACK_OUTPUT_PRICE_MICROS=
BRIDGE_FALLBACK_DAILY_USD=1

# The daily email by tag (US-456): Resend over SMTP. The box blocks 465 and
# 587, so port 2465 with TLS from the start. Without SMTP_HOST and SMTP_FROM
# the form says email is unavailable and the worker sends nothing.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=
# Generate once: openssl rand -hex 24. Salts the hashed IP that limits sign-ups.
RADAR_IP_SALT=
