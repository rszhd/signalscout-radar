# The box's .env for Radar (/root/signalscout-radar/.env). Never committed.

# Local only; compose sets it on the box.
# DATABASE_URL=postgres://radar:radar@127.0.0.1:5439/radar

# Generate once: openssl rand -hex 24
POSTGRES_PASSWORD=

# The Traefik network the SignalScout stacks join.
EDGE_NETWORK=qassist-edge

# Where "remove a post" links to: a mailto: or a URL.
RADAR_CONTACT=

# Providers: the cloud's instance keys.
SOCIALDATA_API_KEY=
SCRAPECREATORS_API_KEY=

# The model that sorts posts: a cheap one that follows a schema.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_TIMEOUT_MS=30000
# Required for the daily cap: a model with no price counts at its worst case.
AI_INPUT_PRICE_MICROS=
AI_OUTPUT_PRICE_MICROS=

# Providers and model together, per UTC day.
RADAR_DAILY_CAP_USD=2
