---
import "@/styles/globals.css";

import { signalscoutUrl, siteUrl } from "@/lib/links";

interface Props {
  title: string;
  description: string;
  /** The share card, a path under public/: /og/home.png, /og/c/<slug>.png. */
  image?: string;
  /** A feed for this page, shown to readers that look for one. */
  feed?: { title: string; path: string };
  /** For the UTM tag on links to SignalScout: the category, or "home". */
  campaign?: string;
}

const { title, description, image = "/og/home.png", feed, campaign = "home" } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
// Public: it is in every page the landing serves. One property for both
// sites, so a visitor who goes from Radar to the landing is one journey.
const analyticsId = process.env.GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/brand/mark-small.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.path} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SignalScout Radar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@signalscoutrun" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {
      analyticsId && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
          <script is:inline define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() { window.dataLayer.push(arguments); };
            window.gtag("js", new Date());
            window.gtag("config", analyticsId);
          </script>
        </Fragment>
      )
    }
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-20 border-b bg-card/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-[1240px] items-center justify-between gap-4 px-4 sm:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/mark.svg" alt="" class="size-7" />
          <span class="font-semibold tracking-tight">SignalScout</span>
          <span class="rounded-full bg-brand-soft px-2 py-0.5 text-[0.75rem] font-semibold tracking-wide text-primary uppercase">
            Radar
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-[0.9375rem] text-secondary-foreground md:flex">
          <a href="/#categories" class="hover:text-foreground">Categories</a>
          <a href="/#latest" class="hover:text-foreground">Latest</a>
          <a href="/about" class="hover:text-foreground">How it works</a>
        </nav>
        <a
          href={signalscoutUrl("header", campaign)}
          class="inline-flex shrink-0 items-center gap-1 text-[0.9375rem] font-semibold whitespace-nowrap text-secondary-foreground hover:text-primary"
        >
          SignalScout <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t bg-card">
      <div class="mx-auto flex max-w-[1240px] flex-col gap-4 px-4 py-10 text-[0.875rem] text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p class="max-w-xl">
          Public posts, shown as a short excerpt and a link. No names, no copies, nothing older than
          30 days. <a href="/about#remove" class="font-semibold text-primary hover:underline">Ask us to remove a post</a>.
        </p>
        <p>
          Made with <a href={signalscoutUrl("footer", campaign)} class="font-semibold text-foreground hover:underline">SignalScout</a>
        </p>
      </div>
    </footer>
  </body>
</html>
