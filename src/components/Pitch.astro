---
/**
 * The one line to BuyerFinder, after the feed. Plain text, not a card: a
 * sticky sales banner beside every post reads as an advert, and the people
 * this page is shared with (Reddit, first) distrust one on sight.
 */
import { buyerfinderUrl } from "@/lib/links";

interface Props {
  topic?: string;
  /** The category slug, for the UTM tag. */
  campaign?: string;
}

const { topic, campaign = "home" } = Astro.props;
---

<p class="mt-10 border-t pt-6 text-[0.9375rem] leading-relaxed text-muted-foreground">
  {topic ? `Sell something in ${topic}?` : "Sell something people ask about here?"} Paste your website into{" "}
  <a href={buyerfinderUrl("pitch", campaign)} class="font-semibold text-foreground hover:underline">BuyerFinder</a>, and
  it shows you the posts where people ask for a product like yours.
</p>
