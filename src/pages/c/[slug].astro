---
import { CategoryList } from "@/components/CategoryList";
import { Feed } from "@/components/Feed";
import Pitch from "@/components/Pitch.astro";
import { categoryCounts, requestsIn } from "@/db/queries.ts";
import Layout from "@/layouts/Layout.astro";
import { db } from "@/lib/db";
import { platforms, toCard, toTiles } from "@/lib/present";
import { categoryBySlug } from "@/sort/categories.ts";

const category = categoryBySlug(Astro.params.slug ?? "");
if (!category) return new Response("Not found", { status: 404 });

const sql = db();
const now = new Date();
const [rows, counts] = await Promise.all([requestsIn(sql, category.slug, 100), categoryCounts(sql, now)]);
const cards = rows.map((row) => toCard(row, now));
const tiles = toTiles(counts);
const own = tiles.find((tile) => tile.slug === category.slug);
const related = tiles.filter((tile) => tile.kind === category.kind && tile.slug !== category.slug).slice(0, 6);
const byPlatform = (["reddit", "x"] as const)
  .map((key) => ({ key, count: rows.filter((row) => row.platform === key).length }))
  .sort((a, b) => b.count - a.count);
const busiest = byPlatform[0]?.count ? platforms[byPlatform[0].key].name : "—";
const name = category.name;
const lower = name.toLowerCase();

Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<Layout
  title={`People asking for ${lower} recommendations | SignalScout Radar`}
  description={`${own?.week ?? 0} public posts this week where someone asks which ${lower} product to use or buy. From Reddit and X, refreshed every hour.`}
>
  <section class="border-b bg-card">
    <div class="mx-auto max-w-[1240px] px-4 py-10 sm:px-8">
      <nav class="text-[0.875rem] text-muted-foreground">
        <a href="/" class="hover:text-foreground">Radar</a>
        <span class="mx-1.5">/</span>
        <a href="/#categories" class="hover:text-foreground">{category.kind === "software" ? "Software" : "Things people buy"}</a>
        <span class="mx-1.5">/</span>
        <span class="text-foreground">{name}</span>
      </nav>
      <h1 class="mt-4 text-3xl leading-tight font-semibold tracking-[-0.03em] sm:text-5xl">
        People asking for {name}
      </h1>
      <p class="mt-3 max-w-2xl text-[0.9375rem] text-secondary-foreground">Covers {category.covers}.</p>
      <div class="mt-5 grid max-w-xl grid-cols-3 gap-3">
        <div class="rounded-xl border bg-background px-4 py-3">
          <p class="text-[0.8125rem] text-muted-foreground">Last 7 days</p>
          <p class="text-2xl font-semibold tabular-nums">{own?.week ?? 0}</p>
        </div>
        <div class="rounded-xl border bg-background px-4 py-3">
          <p class="text-[0.8125rem] text-muted-foreground">Vs. last week</p>
          {own?.trend == null ? (
            <p class="text-2xl font-semibold text-muted-foreground">—</p>
          ) : (
            <p class:list={["text-2xl font-semibold tabular-nums", own.trend >= 0 ? "text-success" : "text-muted-foreground"]}>
              {own.trend >= 0 ? "+" : "−"}{Math.abs(own.trend)}%
            </p>
          )}
        </div>
        <div class="rounded-xl border bg-background px-4 py-3">
          <p class="text-[0.8125rem] text-muted-foreground">Most active</p>
          <p class="text-2xl font-semibold">{busiest}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1240px] grid-cols-[minmax(0,1fr)] gap-8 px-4 pt-10 sm:px-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div>
      <Feed client:load requests={cards} showCategory={false} />
    </div>
    <div class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
      <Pitch topic={name} />
      {related.length > 0 && (
        <div>
          <h2 class="mb-3 text-[0.8125rem] font-semibold tracking-wider text-muted-foreground uppercase">Related</h2>
          <CategoryList categories={related} compact />
        </div>
      )}
    </div>
  </section>
</Layout>
