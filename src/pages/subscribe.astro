---
/** Every tag, to follow by email. US-456. */
import { Subscribe, type TagGroup } from "@/components/Subscribe";
import { shownTags } from "@/db/tags.ts";
import Layout from "@/layouts/Layout.astro";
import { db } from "@/lib/db";
import { mailReady } from "@/lib/site.ts";
import { offeredCategories } from "@/sort/categories.ts";

if (!mailReady()) return Astro.redirect("/", 302);
const tags = await shownTags(db());
const groups: TagGroup[] = offeredCategories
  .map((category) => ({
    category: category.slug,
    name: category.name,
    tags: tags.filter((tag) => tag.category === category.slug).map(({ slug, name, week }) => ({ slug, name, week })),
  }))
  .filter((group) => group.tags.length > 0);
const picked = Astro.url.searchParams.getAll("tag");

Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<Layout
  title="Get buyers by email | SignalScout Radar"
  description="Pick what you sell. Every morning, Radar emails you the new public posts from people asking which one to buy. Free."
>
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="text-3xl leading-tight font-semibold tracking-[-0.03em] sm:text-4xl">Get buyers by email</h1>
    <p class="mt-3 text-[0.9375rem] text-secondary-foreground">
      People ask on Reddit and X which product to buy. Pick the tags for what you sell, and every morning we email you
      the new posts, with what each person wants and a link to answer them.
    </p>
    <div class="mt-8">
      <Subscribe client:load groups={groups} selected={picked} title="Pick your tags" />
    </div>
  </section>
</Layout>
